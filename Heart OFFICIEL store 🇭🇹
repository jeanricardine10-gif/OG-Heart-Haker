<!DOCTYPE html>
<html lang="ht">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>❤️ Heart OFFICIEL Store 🇭🇹</title>

<style>
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:Arial,sans-serif;
}

body{
    background:#f5f5f7;
    color:#111827;
}

header{
    background:linear-gradient(135deg,#111827,#991b1b);
    color:white;
    padding:18px;
    position:sticky;
    top:0;
    z-index:100;
    box-shadow:0 4px 15px #0004;
}

.header{
    max-width:1100px;
    margin:auto;
    display:flex;
    justify-content:space-between;
    align-items:center;
}

.logo{
    font-size:20px;
    font-weight:bold;
}

.menu{
    display:flex;
    gap:18px;
}

.menu a{
    color:white;
    text-decoration:none;
    font-size:14px;
}

.hero{
    text-align:center;
    padding:70px 20px;
    background:linear-gradient(135deg,#fee2e2,#ffffff,#dbeafe);
}

.hero h1{
    font-size:42px;
    margin-bottom:12px;
}

.hero p{
    color:#4b5563;
    font-size:18px;
    margin-bottom:25px;
}

.button{
    display:inline-block;
    background:#dc2626;
    color:white;
    padding:13px 25px;
    border-radius:12px;
    text-decoration:none;
    font-weight:bold;
    border:none;
    cursor:pointer;
}

.container{
    width:92%;
    max-width:1100px;
    margin:auto;
}

section{
    padding:45px 0;
}

.title{
    text-align:center;
    margin-bottom:30px;
}

.title h2{
    font-size:30px;
}

.title p{
    color:#6b7280;
    margin-top:7px;
}

.categories{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(130px,1fr));
    gap:12px;
}

.category{
    background:white;
    padding:20px 10px;
    text-align:center;
    border-radius:15px;
    box-shadow:0 4px 15px #00000010;
    font-weight:bold;
    border:1px solid #eee;
}

.products{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(220px,1fr));
    gap:18px;
}

.product{
    background:white;
    padding:20px;
    border-radius:18px;
    box-shadow:0 5px 18px #00000010;
    border:1px solid #eee;
}

.product-icon{
    font-size:38px;
    margin-bottom:12px;
}

.product h3{
    margin-bottom:8px;
}

.product p{
    color:#6b7280;
    font-size:14px;
    min-height:40px;
}

.price{
    font-size:21px;
    font-weight:bold;
    margin:16px 0;
}

.buy{
    width:100%;
}

.features{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(200px,1fr));
    gap:15px;
}

.feature{
    background:#111827;
    color:white;
    padding:25px;
    border-radius:18px;
}

.feature-icon{
    font-size:30px;
    margin-bottom:10px;
}

footer{
    background:#111827;
    color:white;
    text-align:center;
    padding:35px 20px;
}

.notice{
    text-align:center;
    color:#6b7280;
    font-size:12px;
    margin-top:25px;
}

@media(max-width:650px){

    .header{
        flex-direction:column;
        gap:12px;
    }

    .menu{
        gap:10px;
        flex-wrap:wrap;
        justify-content:center;
    }

    .hero h1{
        font-size:32px;
    }

    .products{
        grid-template-columns:1fr 1fr;
    }

}

@media(max-width:420px){

    .products{
        grid-template-columns:1fr;
    }

}
</style>
</head>


